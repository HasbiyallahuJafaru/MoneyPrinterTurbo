{
  "name": "moneyprinterturbo-desktop",
  "productName": "MoneyPrinterTurbo",
  "version": "1.0.0",
  "description": "Desktop shell for MoneyPrinterTurbo: generate videos and schedule them to social networks via Metricool.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "set MPT_DEV=1&& electron .",
    "dist": "electron-builder"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.moneyprinterturbo.desktop",
    "productName": "MoneyPrinterTurbo",
    "files": [
      "src/**/*",
      "renderer/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
